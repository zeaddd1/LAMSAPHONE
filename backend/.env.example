DATABASE_URL=postgres://user:password@postgres-internal-host:5432/medusa
REDIS_URL=redis://default:password@redis-internal-host:6379
JWT_SECRET=generate-with-openssl-rand-hex-32
COOKIE_SECRET=generate-with-openssl-rand-hex-32
MEDUSA_WORKER_MODE=shared
MEDUSA_BACKEND_URL=https://cp.lamsaphone.yemenbay.com
STORE_CORS=https://lamsaphone.yemenbay.com
ADMIN_CORS=https://cp.lamsaphone.yemenbay.com
AUTH_CORS=https://lamsaphone.yemenbay.com,https://cp.lamsaphone.yemenbay.com
DISABLE_MEDUSA_ADMIN=false
NODE_ENV=production
S3_FILE_URL=https://pub-xxxx.r2.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=lamsaphone
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
LOW_STOCK_THRESHOLD=3
LOG_LEVEL=info
