# انسخ هذا الملف إلى .coolify.env (بنفس المجلد) واملأ القيم. لا ترفع .coolify.env إلى Git.
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=
# من رابط المشروع في Coolify: /project/<UUID>/...
COOLIFY_PROJECT_UUID=
# true = قراءة فقط (لا نشر ولا تعديل). غيّرها إلى false عندما تريد السماح بالنشر.
COOLIFY_READONLY=true
